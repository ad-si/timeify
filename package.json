{
  "name": "timeify",
  "version": "0.2.3",
  "description": "Full ISO 8601 compatible parser.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "test": "ava --fail-fast",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "iso 8601",
    "time",
    "date"
  ],
  "author": "Adrian Sieber",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ava": "^5.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "unexpected": "^10.10.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adius/timeify.git"
  },
  "bugs": {
    "url": "https://github.com/adius/timeify/issues"
  },
  "homepage": "https://github.com/adius/timeify#readme",
  "dependencies": {
    "@datatypes/duration": "^0.4.0",
    "@datatypes/interval": "^0.3.1",
    "@datatypes/moment": "^0.4.0",
    "babel-polyfill": "^6.7.2",
    "zpad": "^0.5.0"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "files": [
      "test/**/*.ts"
    ],
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.test.json",
      "TS_NODE_FILES": "true"
    }
  }
}
