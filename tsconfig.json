{
	"compilerOptions": {
		"target": "es2018",
		"module": "commonjs",
		"lib": ["es2018"],
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"declaration": true,
		"outDir": "build",
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["source/**/*"]
}
